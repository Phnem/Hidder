# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.spec

# C/Rust build artifacts
target/
*.pdb
*.exp
*.lib

# PyInstaller / Diagnostic build folders
build/
community/build/
community/build_diagnostic/
community/dist_diagnostic/
community/dist/*.json
community/dist/*.exe
community/*.json
*.json

# Downloaded vendor packages & databases
DB/keyboard/
DB/data/*.sqlite*
DB/data/*.db
DB/data/extracted_test/
inbox/
*.zip
*.tar.*
*.7z
*.rar

# Node / JS artifacts
node_modules/
app/node_modules/
app/dist/

# OS artifacts
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store

# Vetro Probe schemas + rank/knowledge artifacts are tracked (exception to *.json)
!community/vetro_probe/schema/*.json
!community/vetro_probe/knowledge/*.json

# Vetro Probe dedicated capture browser profile (persistent WebHID grants; not committed)
community/vetro_probe/.capture_profile/

# Provenance records are evidence, not downloads. The blanket `*.json` rule
# above targets fetched vendor packages and databases; these manifests are
# hand-produced records of WHERE an artifact came from and WHAT its hash was,
# and a provenance record that is not version-controlled is not a record.
# The artifacts themselves stay out of the repo (see data/README.md).
!DB/reports/protocol_knowledge/*/acquisition/*.json
# Same reasoning for static-lane output: an extracted command table is a record
# of FACTS about a protocol (the precedent is docs/prior-art/aula-bytech-*.md),
# not a decompiled bundle. The bundle itself is still never committed.
!DB/reports/protocol_knowledge/*/static/*.json
# And for analysis output -- echo audits, UI inventories, address maps. These
# are INTERPRETATION of a capture, which is the deliverable of a lane rather
# than a fetched artifact. Kept separate from oracle/ on purpose: oracle/ holds
# the raw captures a blind inference run reads, and mixing our decoding into
# those files makes "the engine recovered the structure" unfalsifiable. The
# leakage gate enforces that split.
!DB/reports/protocol_knowledge/*/analysis/*.json
