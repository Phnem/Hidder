# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.spec

# C/Rust build artifacts
target/
*.pdb
*.exp
*.lib

# PyInstaller / Diagnostic build folders
build/
community/build/
community/build_diagnostic/
community/dist_diagnostic/
community/dist/*.json
community/dist/*.exe
community/*.json
*.json

# Downloaded vendor packages & databases
DB/keyboard/
DB/data/*.sqlite*
DB/data/*.db
DB/data/extracted_test/
inbox/
*.zip
*.tar.*
*.7z
*.rar

# Node / JS artifacts
node_modules/
app/node_modules/
app/dist/

# OS artifacts
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store

# Vetro Probe schemas are tracked (exception to *.json)
!community/vetro_probe/schema/*.json

# Provenance records are evidence, not downloads. The blanket `*.json` rule
# above targets fetched vendor packages and databases; these manifests are
# hand-produced records of WHERE an artifact came from and WHAT its hash was,
# and a provenance record that is not version-controlled is not a record.
# The artifacts themselves stay out of the repo (see data/README.md).
!DB/reports/protocol_knowledge/*/acquisition/*.json
